#! usr/bin/env bash

s=${1:- $USER} # :- helps set default values if actual values are not found

echo "HELLO $s!"

caps=${s^^} # make whole variable into caps

echo " $caps" 

caps=${s^} # make first letter into caps

echo "$caps"

caps=${s//a/o}

echo "$caps"

path=$(pwd)

echo "${path%/*}" # deletes evything before the / from the end and use # from the start
echo "${path%%/*}" # deletes evything up to the last / from the end and use ## from the start









